    "dodecahedron": {"radius": 1, "detail": 0},
    "tetrahedron": {"radius": 1, "detail": 0},
    "torus": {"radius": 1, "tube": 0.3, "radialSegments": 12, "tubularSegments": 48, "arc": 6.2832},
    "torusKnot": {"radius": 1, "tube": 0.3, "tubularSegments": 128, "radialSegments": 12, "p": 2, "q": 3},
    "cylinder": {"radiusTop": 1, "radiusBottom": 1, "height": 1, "radialSegments": 32, "heightSegments": 1, "openEnded": false},
    "cone": {"radius": 1, "height": 1, "radialSegments": 32, "openEnded": false},
    "capsule": {"radius": 0.5, "length": 1, "capSegments": 4, "radialSegments": 8},
    "plane": {"size": [1, 1], "segments": [1, 1]},
    "circle": {"radius": 1, "segments": 32},
    "ring": {"inner": 0.5, "outer": 1, "segments": 32},
    "lathe": {"segments": 32},
    "extrude": {"depth": 1, "bevel": 0, "curveSegments": 4, "holes": []},
    "tube": {"radius": 0.1, "tubularSegments": 64, "radialSegments": 8, "closed": false},
    "parametric": {"slices": 64, "stacks": 64, "a": 1, "b": 1, "c": 1, "size": 1}
