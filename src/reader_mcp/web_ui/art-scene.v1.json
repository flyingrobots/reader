      "materials": {"type": {"kind": "map", "key": "id", "value": "material", "max": "@limits.materials"}},
      "objects": {"type": {"kind": "list", "item": "node", "min": 1, "max": "@limits.nodes"}, "required": true},
      "links": {"type": {"kind": "list", "item": "link", "max": "@limits.links"}}
    }},
    "fog": {"kind": "object", "fields": {
      "color": {"type": "color"},
      "near": {"type": {"kind": "number", "min": 0, "max": 200}},
      "far": {"type": {"kind": "number", "min": 0.1, "max": 400}},
      "density": {"type": {"kind": "number", "min": 0, "max": 0.5}}
    }},
    "still": {"kind": "object", "fields": {
      "at": {"type": {"kind": "number", "min": 0, "max": 60}}
    }},
    "camera": {"kind": "object", "fields": {
      "position": {"type": "vec3"},
      "target": {"type": "vec3"},
      "fov": {"type": {"kind": "number", "min": 15, "max": 90}},
      "motion": {"type": "camera-motion"}
    }},
    "camera-motion": {"kind": "tagged", "tag": "kind", "variants": {
      "still": {"fields": {}},
      "orbit": {"fields": {"period": {"type": "period"}, "axis": {"type": "axis"}, "direction": {"type": {"kind": "enum", "values": [1, -1]}}}},
      "sway": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 1.5}}, "period": {"type": "period"}}},
      "dolly": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 0.5}}, "period": {"type": "period"}}}
    }},
    "light": {"kind": "tagged", "tag": "type", "variants": {
      "ambient": {"fields": {"color": {"type": "color"}, "intensity": {"type": {"kind": "number", "min": 0, "max": 6}}}},
      "hemisphere": {"fields": {"color": {"type": "color"}, "ground": {"type": "color"}, "intensity": {"type": {"kind": "number", "min": 0, "max": 6}}}},
      "directional": {"fields": {"color": {"type": "color"}, "intensity": {"type": {"kind": "number", "min": 0, "max": 8}}, "position": {"type": "vec3"}, "target": {"type": "vec3"}}},
      "point": {"fields": {"id": {"type": "id"}, "color": {"type": "color"}, "intensity": {"type": {"kind": "number", "min": 0, "max": 60}}, "position": {"type": "vec3"}, "distance": {"type": {"kind": "number", "min": 0, "max": 200}}, "decay": {"type": {"kind": "number", "min": 0, "max": 3}}, "animate": {"type": "animations"}}},
      "spot": {"fields": {"color": {"type": "color"}, "intensity": {"type": {"kind": "number", "min": 0, "max": 60}}, "position": {"type": "vec3"}, "target": {"type": "vec3"}, "angle": {"type": {"kind": "number", "min": 0.05, "max": 1.5}}, "penumbra": {"type": "unit"}, "distance": {"type": {"kind": "number", "min": 0, "max": 200}}}}
    }},
    "material": {"kind": "object", "fields": {
      "type": {"type": {"kind": "enum", "values": ["basic", "lambert", "standard", "physical", "toon"]}},
      "color": {"type": "color"},
      "emissive": {"type": "color"},
      "emissiveIntensity": {"type": {"kind": "number", "min": 0, "max": 4}},
      "roughness": {"type": "unit"},
      "metalness": {"type": "unit"},
      "clearcoat": {"type": "unit"},
      "transmission": {"type": "unit"},
      "opacity": {"type": "unit"},
      "wireframe": {"type": {"kind": "boolean"}},
      "flatShading": {"type": {"kind": "boolean"}},
      "side": {"type": {"kind": "enum", "values": ["front", "back", "double"]}},
      "blending": {"type": {"kind": "enum", "values": ["normal", "additive"]}}
    }},
    "material-ref": {"kind": "alternatives", "string": "id", "object": "material"},

    "node": {"kind": "tagged", "tag": "type", "common": {
      "id": {"type": "id"},
      "position": {"type": "vec3"},
      "rotation": {"type": "euler"},
      "scale": {"type": "scale"},
      "animate": {"type": "animations"}
    }, "variants": {
      "mesh": {"fields": {"geometry": {"type": "geometry", "required": true}, "material": {"type": "material-ref"}}},
      "group": {"fields": {"children": {"type": {"kind": "list", "item": "node", "min": 1, "max": "@limits.nodes"}, "required": true}}},
      "instances": {"fields": {
        "geometry": {"type": "geometry", "required": true},
        "material": {"type": "material-ref"},
        "count": {"type": {"kind": "integer", "min": 1, "max": "@limits.instances"}, "required": true},
        "layout": {"type": "layout", "required": true},
        "colors": {"type": "colors"},
        "each": {"type": "each"}
      }},
      "particles": {"fields": {
        "count": {"type": {"kind": "integer", "min": 1, "max": "@limits.particles"}, "required": true},
        "shape": {"type": {"kind": "enum", "values": ["sphere", "shell", "box", "disc", "ring"]}},
        "radius": {"type": "len"},
        "size": {"type": "scale3"},
        "pointSize": {"type": {"kind": "number", "min": 0.002, "max": 0.5}},
        "color": {"type": "color"},
        "colors": {"type": "colors"},
        "opacity": {"type": "unit"},
        "blending": {"type": {"kind": "enum", "values": ["normal", "additive"]}},
        "motion": {"type": "particle-motion"},
        "seed": {"type": "seed"}
      }},
      "line": {"fields": {
        "points": {"type": {"kind": "list", "item": "vec3", "min": 2, "max": 512}, "required": true},
        "closed": {"type": {"kind": "boolean"}},
        "smooth": {"type": {"kind": "boolean"}},
        "color": {"type": "color"},
        "opacity": {"type": "unit"}
      }}
    }},
    "layout": {"kind": "tagged", "tag": "kind", "common": {
      "jitter": {"type": "unit"},
      "scaleRange": {"type": {"kind": "tuple", "length": 2, "item": {"kind": "number", "min": 0.01, "max": 10}}},
      "seed": {"type": "seed"},
      "facing": {"type": {"kind": "enum", "values": ["none", "outward", "center", "tangent", "random"]}}
    }, "variants": {
