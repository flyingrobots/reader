    "unit": {"kind": "number", "min": 0, "max": 1},
    "signed": {"kind": "number", "min": -1, "max": 1},
    "len": {"kind": "number", "min": 0.001, "max": 20},
    "len0": {"kind": "number", "min": 0, "max": 20},
    "angle": {"kind": "number", "min": -25.2, "max": 25.2},
    "period": {"kind": "number", "min": 2, "max": 600},
    "seed": {"kind": "integer", "min": 0, "max": 2147483647},
    "id": {"kind": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "vec3": {"kind": "tuple", "length": 3, "item": "coord"},
    "vec2": {"kind": "tuple", "length": 2, "item": "coord"},
    "dir3": {"kind": "tuple", "length": 3, "item": "signed"},
    "euler": {"kind": "tuple", "length": 3, "item": "angle"},
    "scale3": {"kind": "tuple", "length": 3, "item": {"kind": "number", "min": 0.001, "max": 50}},
    "scale": {"kind": "alternatives", "number": {"kind": "number", "min": 0.001, "max": 50}, "array": "scale3"},
    "axis": {"kind": "alternatives", "string": {"kind": "enum", "values": ["x", "y", "z"]}, "array": "dir3"},
    "token": {"kind": "enum", "values": "@tokens"},
    "color": {"kind": "alternatives", "string": "token", "object": "color-mix"},
    "color-mix": {"kind": "object", "fields": {
