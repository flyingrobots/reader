      "spiral": {"fields": {"radius": {"type": "len"}, "turns": {"type": {"kind": "number", "min": 0.1, "max": 40}}, "growth": {"type": {"kind": "number", "min": 0, "max": 5}}}},
      "helix": {"fields": {"radius": {"type": "len"}, "height": {"type": "len0"}, "turns": {"type": {"kind": "number", "min": 0.1, "max": 40}}}},
      "grid": {"fields": {"columns": {"type": {"kind": "integer", "min": 1, "max": 200}}, "spacing": {"type": "len"}, "layers": {"type": {"kind": "integer", "min": 1, "max": 50}}}},
      "sphere": {"fields": {"radius": {"type": "len"}}},
      "scatter": {"fields": {"size": {"type": "scale3"}}},
      "line": {"fields": {"from": {"type": "vec3"}, "to": {"type": "vec3"}}},
      "path": {"fields": {"points": {"type": {"kind": "list", "item": "vec3", "min": 2, "max": 256}, "required": true}}}
    }},
    "each": {"kind": "tagged", "tag": "kind", "variants": {
