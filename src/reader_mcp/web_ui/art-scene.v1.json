      "saturation": {"type": {"kind": "number", "min": -1, "max": 1}},
      "hue": {"type": {"kind": "number", "min": -60, "max": 60}},
      "light": {"type": "color"},
      "dark": {"type": "color"}
    }, "either": [["token"], ["light", "dark"]]},
    "colors": {"kind": "list", "item": "color", "min": 1, "max": 12},

    "scene": {"kind": "object", "fields": {
      "reader_scene": {"type": {"kind": "enum", "values": [1]}, "required": true},
