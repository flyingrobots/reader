      "torusKnot": {"fields": {"radius": {"type": "len"}, "tube": {"type": "len"}, "tubularSegments": {"type": {"kind": "integer", "min": 8, "max": 512}}, "radialSegments": {"type": {"kind": "integer", "min": 3, "max": 32}}, "p": {"type": {"kind": "integer", "min": 1, "max": 12}}, "q": {"type": {"kind": "integer", "min": 1, "max": 12}}}},
      "cylinder": {"fields": {"radiusTop": {"type": "len0"}, "radiusBottom": {"type": "len0"}, "height": {"type": "len"}, "radialSegments": {"type": {"kind": "integer", "min": 3, "max": 64}}, "heightSegments": {"type": {"kind": "integer", "min": 1, "max": 32}}, "openEnded": {"type": {"kind": "boolean"}}}},
      "cone": {"fields": {"radius": {"type": "len"}, "height": {"type": "len"}, "radialSegments": {"type": {"kind": "integer", "min": 3, "max": 64}}, "openEnded": {"type": {"kind": "boolean"}}}},
      "capsule": {"fields": {"radius": {"type": "len"}, "length": {"type": "len0"}, "capSegments": {"type": {"kind": "integer", "min": 1, "max": 16}}, "radialSegments": {"type": {"kind": "integer", "min": 3, "max": 32}}}},
      "plane": {"fields": {"size": {"type": {"kind": "tuple", "length": 2, "item": {"kind": "number", "min": 0.001, "max": 100}}}, "segments": {"type": {"kind": "tuple", "length": 2, "item": {"kind": "integer", "min": 1, "max": 128}}}, "wave": {"type": "surface-wave"}}},
      "circle": {"fields": {"radius": {"type": "len"}, "segments": {"type": {"kind": "integer", "min": 3, "max": 128}}}},
      "ring": {"fields": {"inner": {"type": "len0"}, "outer": {"type": "len"}, "segments": {"type": {"kind": "integer", "min": 3, "max": 128}}}},
      "lathe": {"fields": {"points": {"type": {"kind": "list", "item": {"kind": "tuple", "length": 2, "item": "coord"}, "min": 2, "max": 256}, "required": true}, "segments": {"type": {"kind": "integer", "min": 3, "max": 128}}}},
      "extrude": {"fields": {"shape": {"type": {"kind": "list", "item": "vec2", "min": 3, "max": 256}, "required": true}, "holes": {"type": {"kind": "list", "item": {"kind": "list", "item": "vec2", "min": 3, "max": 128}, "max": 8}}, "depth": {"type": "len0"}, "bevel": {"type": {"kind": "number", "min": 0, "max": 1}}, "curveSegments": {"type": {"kind": "integer", "min": 1, "max": 16}}}},
      "tube": {"fields": {"points": {"type": {"kind": "list", "item": "vec3", "min": 2, "max": 256}, "required": true}, "radius": {"type": "len"}, "tubularSegments": {"type": {"kind": "integer", "min": 2, "max": 1024}}, "radialSegments": {"type": {"kind": "integer", "min": 3, "max": 32}}, "closed": {"type": {"kind": "boolean"}}}},
      "parametric": {"fields": {"surface": {"type": {"kind": "enum", "values": ["klein", "mobius", "saddle", "shell", "helicoid", "wave", "dupin", "spherical-harmonic"]}, "required": true}, "slices": {"type": {"kind": "integer", "min": 2, "max": 128}}, "stacks": {"type": {"kind": "integer", "min": 2, "max": 128}}, "a": {"type": {"kind": "number", "min": -10, "max": 10}}, "b": {"type": {"kind": "number", "min": -10, "max": 10}}, "c": {"type": {"kind": "number", "min": -10, "max": 10}}, "size": {"type": "len"}}},
      "custom": {"fields": {"vertices": {"type": {"kind": "list", "item": "vec3", "min": 3, "max": 4096}, "required": true}, "faces": {"type": {"kind": "list", "item": {"kind": "tuple", "length": 3, "item": {"kind": "integer", "min": 0, "max": 4095}}, "min": 1, "max": 8192}, "required": true}}}
