      "spin": {"fields": {"period": {"type": "period"}, "stagger": {"type": "unit"}}},
      "pulse": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 0.8}}, "period": {"type": "period"}, "stagger": {"type": "unit"}}},
      "wave": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 5}}, "period": {"type": "period"}, "wavelength": {"type": {"kind": "number", "min": 0.1, "max": 100}}}}
    }},
    "particle-motion": {"kind": "tagged", "tag": "kind", "variants": {
      "still": {"fields": {}},
      "drift": {"fields": {"speed": {"type": {"kind": "number", "min": 0, "max": 3}}}},
      "swirl": {"fields": {"speed": {"type": {"kind": "number", "min": 0, "max": 3}}, "axis": {"type": "axis"}}},
      "rise": {"fields": {"speed": {"type": {"kind": "number", "min": 0, "max": 3}}}},
      "fall": {"fields": {"speed": {"type": {"kind": "number", "min": 0, "max": 3}}}},
      "breathe": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 0.6}}, "period": {"type": "period"}}}
    }},
    "animations": {"kind": "list", "item": "animation", "max": 8},
    "animation": {"kind": "tagged", "tag": "kind", "variants": {
      "spin": {"fields": {"axis": {"type": "axis"}, "period": {"type": "period", "required": true}, "direction": {"type": {"kind": "enum", "values": [1, -1]}}}},
      "oscillate": {"fields": {
        "property": {"type": {"kind": "enum", "values": ["position.x", "position.y", "position.z", "rotation.x", "rotation.y", "rotation.z", "scale", "opacity", "emissiveIntensity"]}, "required": true},
        "amplitude": {"type": {"kind": "number", "min": 0, "max": 10}, "required": true},
        "period": {"type": "period", "required": true},
        "phase": {"type": "unit"}
      }},
      "orbit": {"fields": {"center": {"type": "vec3"}, "around": {"type": "id"}, "radius": {"type": "len", "required": true}, "period": {"type": "period", "required": true}, "axis": {"type": "axis"}, "phase": {"type": "unit"}}},
      "wander": {"fields": {"amplitude": {"type": {"kind": "number", "min": 0, "max": 5}, "required": true}, "speed": {"type": {"kind": "number", "min": 0.005, "max": 1}}, "seed": {"type": "seed"}}},
      "follow": {"fields": {"target": {"type": "id", "required": true}, "offset": {"type": "vec3"}, "stiffness": {"type": {"kind": "number", "min": 0.1, "max": 20}}, "damping": {"type": {"kind": "number", "min": 0.05, "max": 10}}}},
      "look": {"fields": {"target": {"type": "id", "required": true}}},
      "react": {"fields": {
        "source": {"type": "id", "required": true},
        "property": {"type": {"kind": "enum", "values": ["scale", "opacity", "emissiveIntensity", "position.y"]}, "required": true},
        "near": {"type": "len0", "required": true},
        "far": {"type": "len", "required": true},
        "from": {"type": {"kind": "number", "min": -10, "max": 10}, "required": true},
        "to": {"type": {"kind": "number", "min": -10, "max": 10}, "required": true}
      }}
    }},
    "link": {"kind": "object", "fields": {
      "from": {"type": "id", "required": true},
      "to": {"type": "id", "required": true},
      "color": {"type": "color"},
      "opacity": {"type": "unit"},
      "sag": {"type": {"kind": "number", "min": 0, "max": 5}}
    }},

    "geometry": {"kind": "tagged", "tag": "type", "variants": {
      "box": {"fields": {"size": {"type": "scale3"}, "segments": {"type": {"kind": "integer", "min": 1, "max": 16}}}},
      "sphere": {"fields": {"radius": {"type": "len"}, "widthSegments": {"type": {"kind": "integer", "min": 3, "max": 64}}, "heightSegments": {"type": {"kind": "integer", "min": 2, "max": 48}}}},
      "icosahedron": {"fields": {"radius": {"type": "len"}, "detail": {"type": {"kind": "integer", "min": 0, "max": 5}}}},
