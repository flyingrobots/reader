{
  "$comment": "Reader scene description, version 1 (RW-43). The one source of truth for the Python validator (src/reader_mcp/art_scene.py) and the browser validator (web_ui/art-scene.mjs): both interpret these types generically, then run the same semantic checks (ids, targets, follow cycles, face indices, budgets). Unknown fields are refused everywhere.",
  "version": 1,
  "limits": {
    "bytes": 262144,
    "nodes": 240,
    "depth": 6,
    "materials": 32,
    "lights": 8,
    "links": 64,
    "animations": 400,
    "instances": 6000,
    "particles": 24000,
    "triangles": 400000,
    "errors": 20
  },
  "tokens": ["bg", "surface", "raised", "line", "ink", "muted", "faint", "accent", "accent-ink", "rust", "warning",
             "chart-1", "chart-2", "chart-3", "chart-4", "chart-5", "chart-6", "chart-7", "chart-8", "bright", "deep"],
  "derived_tokens": {"bright": "the lighter of bg and ink", "deep": "the darker of bg and ink"},
  "root": "scene",
  "geometry_defaults": {
