{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": {
    "$ref": "#/$defs/JsonValue"
  },
  "description": "Shared v1 fields; document-specific JSON properties remain extensible.",
  "properties": {
    "frontmatter_schema_version": {
      "const": 1,
      "title": "Frontmatter Schema Version",
      "type": "integer"
    },
    "document_revision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Document Revision",
      "type": "integer"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "type": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Type",
      "type": "string"
    },
    "added": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Added"
    },
    "created": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created"
    },
    "updated": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "tags": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tags"
    }
  },
  "required": [
    "frontmatter_schema_version",
    "document_revision",
    "title",
    "type"
  ],
  "title": "DocumentMetadata",
  "type": "object"
}
